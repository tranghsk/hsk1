  {hz:"他", py:"tā", pos:"đt.", mean:"anh ấy, nó (nam)"},
  {hz:"今年", py:"jīnnián", pos:"dt.", mean:"năm nay"},
  {hz:"多", py:"duō", pos:"đt.", mean:"bao nhiêu, cỡ nào (hỏi mức độ)"},
  {hz:"大", py:"dà", pos:"tt.", mean:"lớn, nhiều tuổi"}
];

const DIALOGUES = {
  d1:[
