  ]
};

const HANZI_LIST = [
  {char:"有", py:"yǒu", radical:"月(nguyệt/nhục)", strokes:6, mean:"có",
   tip:"Phần trên là bàn tay (ナ), phần dưới là 月 (thịt) — tay cầm miếng thịt trong nhà, nghĩa là 'có' của cải."},
  {char:"家", py:"jiā", radical:"宀(miên)", strokes:10, mean:"nhà, gia đình",
   tip:"宀 (mái nhà) trên 豕 (con lợn) — thời xưa nuôi lợn dưới nhà sàn, biểu tượng một gia đình no đủ."},
  {char:"几", py:"jǐ", radical:"几", strokes:2, mean:"mấy (hỏi số lượng nhỏ)",
   tip:"Vốn là hình cái bàn nhỏ có chân — mượn âm để dùng làm từ hỏi số lượng ít, nhỏ hơn 10."},
  {char:"口", py:"kǒu", radical:"口(khẩu)", strokes:3, mean:"miệng; lượng từ đếm người trong nhà",
   tip:"Hình vẽ cái miệng đang há ra — mỗi 'miệng ăn' trong nhà được tính là một 口 (một nhân khẩu)."},
  {char:"爸", py:"bà", radical:"父(phụ)", strokes:8, mean:"bố, cha",
   tip:"父 (người cha, hình bàn tay cầm rìu — trụ cột gia đình) + 巴 (gợi âm 'ba')."},
  {char:"妈", py:"mā", radical:"女(nữ)", strokes:6, mean:"mẹ",
   tip:"女 (nữ) + 马 (mã, gợi âm 'ma') — ghép ý và âm để chỉ người mẹ."},
  {char:"哥", py:"gē", radical:"口(khẩu)", strokes:10, mean:"anh trai",
   tip:"Hai chữ 可 xếp chồng — lặp lại thể hiện cách gọi thân mật, quen thuộc dành cho anh trai."},
  {char:"妹", py:"mèi", radical:"女(nữ)", strokes:8, mean:"em gái",
   tip:"女 (nữ) + 未 (chưa, còn non) — người con gái còn nhỏ tuổi hơn mình, tức em gái."},
  {char:"儿", py:"ér", radical:"儿(nhân đi)", strokes:2, mean:"con (trai); trẻ nhỏ",
   tip:"Hình cách điệu đôi chân của một đứa trẻ đang chập chững — gốc nghĩa 'trẻ con'."},
  {char:"岁", py:"suì", radical:"山(sơn)", strokes:6, mean:"tuổi",
   tip:"Chữ dùng để đếm tuổi, gắn với chu kỳ một năm trôi qua — mỗi lần Trái Đất quay hết một vòng, thêm một 岁."},
  {char:"大", py:"dà", radical:"大(đại)", strokes:3, mean:"to, lớn (tuổi)",
   tip:"Hình một người dang rộng hai tay hai chân — biểu thị ý 'to lớn'; hỏi tuổi người lớn hơn dùng '多大'."}
];

/* ============ GAME HOÁ: XP / STREAK / BADGE / CONFETTI / ÂM THANH ============ */
const GAME = { xp:0, streak:0, bestStreak:0, level:1, badges:{} };
const BADGES = [
  {id:'fill', label:'🎯 Điền từ', need:'fillDone'},
  {id:'order', label:'🧩 Sắp câu', need:'orderDone'},
  {id:'listen', label:'🎧 Nghe hiểu', need:'listenDone'},
  {id:'streak5', label:'🔥 Chuỗi 5', need:'streak5'},
  {id:'hanzi', label:'字 Viết chữ', need:'hanziDone'}
];
function renderBadges(){
  const row = document.getElementById('badge-row');
  row.innerHTML = BADGES.map(b=>`<span class="badge-pill ${GAME.badges[b.id]?'earned':''}">${b.label}</span>`).join('');
}
renderBadges();
function unlockBadge(id){
  if(!GAME.badges[id]){ GAME.badges[id]=true; renderBadges(); showToast('🏅 Mở khoá huy hiệu mới!','gold'); }
}
function updateXpBar(){
  const needed = GAME.level*50;
  document.getElementById('xp-label').textContent = GAME.xp+' XP';
  document.getElementById('lvl-label').textContent = 'Cấp '+GAME.level+' '+(GAME.level<3?'🌱':GAME.level<6?'🌿':'🌳');
  document.getElementById('xp-bar').style.width = Math.min(100,(GAME.xp % needed)/needed*100)+'%';
  document.getElementById('streak-label').textContent = 'Chuỗi đúng: '+GAME.streak;
}
function gainXp(n, correct){
  if(correct){
    GAME.streak++; GAME.bestStreak = Math.max(GAME.bestStreak,GAME.streak);
    if(GAME.streak>=5) unlockBadge('streak5');
  } else {
    GAME.streak = 0;
  }
  GAME.xp += n;
  const needed = GAME.level*50;
  if(GAME.xp >= GAME.level*50 + (GAME.level-1)*0){/*noop*/}
  while(GAME.xp >= levelThreshold(GAME.level)){ GAME.level++; showToast('🎉 Lên cấp '+GAME.level+'!','gold'); }
  updateXpBar();
}
function levelThreshold(lvl){ let t=0; for(let i=1;i<=lvl;i++) t+=i*50; return t; }
function showToast(msg, kind){
  const t = document.getElementById('toast');
  t.textContent = msg; t.className = 'toast show'+(kind==='gold'?' gold':'');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(()=>{ t.classList.remove('show'); }, 1800);
}
function floatPoints(x,y,text){
  const el = document.createElement('div');
  el.className = 'float-pts'; el.textContent = text;
  el.style.left = x+'px'; el.style.top = y+'px';
  document.body.appendChild(el);
  setTimeout(()=>el.remove(),1000);
}
/* âm thanh đơn giản bằng Web Audio API (không cần file mp3) */
let audioCtx;
function beep(freqs, dur){
  try{
    audioCtx = audioCtx || new (window.AudioContext||window.webkitAudioContext)();
    freqs.forEach((f,i)=>{
      const o = audioCtx.createOscillator(); const g = audioCtx.createGain();
      o.type='sine'; o.frequency.value=f;
      o.connect(g); g.connect(audioCtx.destination);
      const start = audioCtx.currentTime + i*dur;
      g.gain.setValueAtTime(0.001,start);
      g.gain.exponentialRampToValueAtTime(0.18,start+0.02);
      g.gain.exponentialRampToValueAtTime(0.001,start+dur);
      o.start(start); o.stop(start+dur);
    });
  }catch(e){}
}
function soundCorrect(){ beep([523,659,784],0.11); }
function soundWrong(){ beep([220,180],0.14); }
function soundLevelUp(){ beep([523,659,784,1046],0.13); }

/* confetti canvas đơn giản */
const cvs = document.getElementById('confetti-canvas');
const ctx = cvs.getContext('2d');
function resizeCanvas(){ cvs.width = innerWidth; cvs.height = innerHeight; }
resizeCanvas(); window.addEventListener('resize', resizeCanvas);
const COLORS = ['#D98A80','#E0A85C','#E8B86B','#9B85C9','#4FAE82','#F0B8AE'];
let confettiParticles = [];
function fireConfetti(x,y,count){
  count = count || 60;
  x = x !== undefined ? x : cvs.width/2;
  y = y !== undefined ? y : cvs.height/3;
  for(let i=0;i<count;i++){
    confettiParticles.push({
      x, y,
      vx:(Math.random()-0.5)*9,
      vy:Math.random()*-9-3,
      g:0.28,
      size:4+Math.random()*4,
      color:COLORS[Math.floor(Math.random()*COLORS.length)],
      rot:Math.random()*360,
      vr:(Math.random()-0.5)*12,
      life:0, maxLife:70+Math.random()*30
    });
  }
  if(!window._confettiLoop){ window._confettiLoop = true; requestAnimationFrame(confettiTick); }
}
function confettiTick(){
  ctx.clearRect(0,0,cvs.width,cvs.height);
  confettiParticles.forEach(p=>{
    p.vy += p.g; p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.life++;
    ctx.save();
    ctx.translate(p.x,p.y); ctx.rotate(p.rot*Math.PI/180);
    ctx.fillStyle = p.color;
    ctx.globalAlpha = Math.max(0, 1 - p.life/p.maxLife);
    ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size*0.6);
    ctx.restore();
  });
  confettiParticles = confettiParticles.filter(p=>p.life < p.maxLife);
  if(confettiParticles.length){ requestAnimationFrame(confettiTick); }
  else { window._confettiLoop = false; ctx.clearRect(0,0,cvs.width,cvs.height); }
}
function celebrate(el, points){
  soundCorrect();
  const rect = el.getBoundingClientRect();
  fireConfetti(rect.left+rect.width/2, rect.top+rect.height/2, 45);
  floatPoints(rect.left+rect.width/2, rect.top, '+'+points+' XP');
  gainXp(points, true);
}
function fail(el){
  soundWrong();
  gainXp(0, false);
}
updateXpBar();

/* ============ CHẾ ĐỘ TRÌNH CHIẾU ============ */
function togglePresent(){
  document.body.classList.toggle('present');
  const on = document.body.classList.contains('present');
  document.getElementById('present-toggle-desktop').classList.toggle('active', on);
  document.getElementById('present-toggle-desktop').textContent = on ? '🖥 Đang trình chiếu' : '🖥 Chế độ trình chiếu';
  try{ localStorage.setItem('tranghsk_present', on ? '1':'0'); }catch(e){}
}
document.getElementById('present-toggle-desktop').addEventListener('click', togglePresent);
document.getElementById('present-toggle-mobile')?.addEventListener('click', togglePresent);
try{
  if(localStorage.getItem('tranghsk_present')==='1'){ togglePresent(); }
}catch(e){}

/* ============ TABS ============ */
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('panel-'+btn.dataset.tab).classList.add('active');
  });
});

/* ============ PHÁT ÂM (Web Speech API) ============ */
function speak(text){
  if(!('speechSynthesis' in window)){ alert('Trình duyệt không hỗ trợ phát âm.'); return; }
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'zh-CN';
  u.rate = 0.85;
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}

/* ============ ẨN/HIỆN PHIÊN ÂM ============ */
function toggleVocabPinyin(){
  const table = document.querySelector('table.vocab');
  const btn = document.getElementById('vocab-py-toggle');
  const hidden = table.classList.toggle('hide-py');
  btn.textContent = hidden ? '👁 Hiện phiên âm' : '🙈 Ẩn phiên âm';
}
function toggleDialoguePinyin(){
  const container = document.getElementById('dialogue-container');
  const btn = document.getElementById('dialogue-py-toggle');
  const hidden = container.classList.toggle('hide-py');
  btn.textContent = hidden ? '👁 Hiện phiên âm' : '🙈 Ẩn phiên âm';
}

/* ============ TAB TỪ VỰNG ============ */
const vocabBody = document.getElementById('vocab-body');
VOCAB.forEach(v=>{
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td><button class="btn-speak" onclick="speak('${v.hz}')">🔊</button></td>
    <td class="hz hanzi">${v.hz}</td>
    <td class="pinyin">${v.py}</td>
    <td>${v.pos?`<span class="pos">${v.pos}</span>`:''}</td>
    <td>${v.mean}</td>`;
  vocabBody.appendChild(tr);
});

/* ============ TAB BÀI KHOÁ (HỘI THOẠI) ============ */
const DLG_GROUPS = [
  { title:"1. Hỏi số lượng học sinh", lines:[
    {who:'m1', name:'Liú Míng',   hzName:'刘明',   py:'Yīfēi máng ma?', hz:'一飞忙吗？'},
    {who:'f1', name:'Wáng Yīxuě', hzName:'王一雪', py:'Tā hěn máng.', hz:'她很忙。'},
    {who:'m1', name:'Liú Míng',   hzName:'刘明',   py:'Tā yǒu duōshao gè xuésheng?', hz:'她有多少个学生？'},
    {who:'f1', name:'Wáng Yīxuě', hzName:'王一雪', py:'Tā yǒu èrshí gè xuésheng.', hz:'她有二十个学生。'}
  ]},
  { title:"2. Hỏi thành viên trong nhà", lines:[
    {who:'f2', name:'Wáng Yīxuě',  hzName:'王一雪', py:'Wǒ yǒu liǎng gè gēge, nǐ ne?', hz:'我有两个哥哥，你呢？'},
    {who:'m2', name:'Yáng Tónglè', hzName:'杨同乐', py:'Wǒ méiyǒu gēge.', hz:'我没有哥哥。'},
    {who:'f2', name:'王一雪',       hzName:'王一雪', py:'Nǐ jiā yǒu jǐ kǒu rén?', hz:'你家有几口人？'},
    {who:'m2', name:'杨同乐',       hzName:'杨同乐', py:'Wǒ jiā yǒu sì kǒu rén, bàba, māma, mèimei hé wǒ.', hz:'我家有四口人，爸爸、妈妈、妹妹和我。'}
  ]},
  { title:"3. Hỏi tuổi con cái", lines:[
    {who:'m3', name:'Yáng Tónglè', hzName:'杨同乐', py:'Zhè shì nín érzi ma?', hz:'这是您儿子吗？'},
    {who:'f3', name:'Wáng Yīxuě',  hzName:'王一雪', py:'Shì de. Wǒ yǒu liǎng gè háizi, yí gè érzi, yí gè nǚ\'ér.', hz:'是的。我有两个孩子，一个儿子，一个女儿。'},
    {who:'m3', name:'杨同乐',       hzName:'杨同乐', py:'Nín érzi jǐ suì?', hz:'您儿子几岁？'},
    {who:'f3', name:'王一雪',       hzName:'王一雪', py:'Tā jīnnián wǔ suì.', hz:'他今年五岁。'},
    {who:'m3', name:'杨同乐',       hzName:'杨同乐', py:'Nín nǚ\'ér duō dà?', hz:'您女儿多大？'},
    {who:'f3', name:'王一雪',       hzName:'王一雪', py:'Tā jīnnián shí\'èr.', hz:'她今年十二。'}
  ]}
];
const DLG_AVATAR = {m1:'🧑', f1:'👩', f2:'👩‍🦰', m2:'🧑‍🦱', f3:'🧑‍🦱', m3:'👩‍🦰'};

const dialogueContainer = document.getElementById('dialogue-container');
DLG_GROUPS.forEach((grp, gi)=>{
  const group = document.createElement('div');
  group.className = 'dialogue-group';
  const linesHz = grp.lines.map(l=>l.hz);
  group.innerHTML = `
    <div class="dialogue-head">
      <span class="dialogue-title">${grp.title}</span>
      <button class="btn secondary btn-play-all" onclick="playDialogue(${gi}, this)">▶ Nghe cả đoạn</button>
    </div>
    <div class="dlg-lines" id="dlg-lines-${gi}"></div>`;
  dialogueContainer.appendChild(group);
  const linesEl = group.querySelector(`#dlg-lines-${gi}`);
  grp.lines.forEach(l=>{
    const row = document.createElement('div');
    row.className = 'dlg-line';
    row.innerHTML = `
      <div class="dlg-avatar-wrap">
        <div class="dlg-avatar">${DLG_AVATAR[l.who]}</div>
        <div class="dlg-who">${l.name}<br><span class="hz-mini hanzi">${l.hzName}</span></div>
      </div>
      <div class="dlg-bubble">
        <div class="dlg-py">${l.py}</div>
        <div class="dlg-hz hanzi">${l.hz}</div>
        <button class="btn-speak" onclick="speak('${l.hz.replace(/'/g,"\\'")}')">🔊</button>
      </div>`;
    linesEl.appendChild(row);
  });
});

function playDialogue(idx, btn){
  if(!('speechSynthesis' in window)){ alert('Trình duyệt không hỗ trợ phát âm.'); return; }
  const lines = DLG_GROUPS[idx].lines.map(l=>l.hz);
  speechSynthesis.cancel();
  btn.disabled = true;
  const original = btn.textContent;
  btn.textContent = '⏸ Đang phát...';
  let i = 0;
  function next(){
    if(i >= lines.length){ btn.disabled = false; btn.textContent = original; return; }
    const u = new SpeechSynthesisUtterance(lines[i]);
    u.lang = 'zh-CN'; u.rate = 0.85;
    u.onend = ()=>{ i++; setTimeout(next, 350); };
    u.onerror = ()=>{ btn.disabled = false; btn.textContent = original; };
    speechSynthesis.speak(u);
  }
  next();
}

/* ============ TAB NGỮ PHÁP ============ */
const GM_EXAMPLES = {
  gm1:[
    {hz:"她有二十个学生。", py:"Tā yǒu èrshí gè xuésheng.", vi:"Chị ấy có hai mươi học sinh."},
    {hz:"她有一个姐姐。", py:"Tā yǒu yí gè jiějie.", vi:"Cô ấy có một chị gái."},
    {hz:"我没/没有姐姐。", py:"Wǒ méi/méiyǒu jiějie.", vi:"Tôi không có chị gái."}
  ],
  gm2:[
    {hz:"十二", py:"shí'èr", vi:"12 (dùng 二 vì là số đếm/số thứ tự)"},
    {hz:"两个人", py:"liǎng gè rén", vi:"hai người (dùng 两 vì đứng trước lượng từ 个)"},
    {hz:"两口人 / 两本书", py:"liǎng kǒu rén / liǎng běn shū", vi:"hai người (nhân khẩu) / hai quyển sách"}
  ],
  gm3:[
    {hz:"我有两个哥哥，你呢？", py:"Wǒ yǒu liǎng gè gēge, nǐ ne?", vi:"Tôi có hai anh trai, còn bạn thì sao?"},
    {hz:"我叫白家月，你呢？", py:"Wǒ jiào Bái Jiāyuè, nǐ ne?", vi:"Tôi tên Bạch Gia Nguyệt, còn bạn?"},
    {hz:"我是中国人，你呢？", py:"Wǒ shì Zhōngguó rén, nǐ ne?", vi:"Tôi là người Trung Quốc, còn bạn?"}
  ],
  gm4:[
    {hz:"四口", py:"sì kǒu", vi:"bốn (nhân khẩu) — chỉ có Số+Lượng, chưa nói rõ danh từ"},
    {hz:"四口人", py:"sì kǒu rén", vi:"bốn người (trong nhà)"},
    {hz:"两个", py:"liǎng gè", vi:"hai (cái/người) — Số+Lượng"},
    {hz:"两个学生", py:"liǎng gè xuésheng", vi:"hai học sinh — Số+Lượng+Danh"}
  ]
};
function renderGM(id, list){
  document.getElementById(id).innerHTML = list.map(x=>`
    <div class="dlg-line" style="margin-bottom:10px;">
      <button class="btn-speak" style="position:static;flex-shrink:0;margin-top:2px;" onclick="speak('${x.hz.replace(/'/g,"\\'")}')">🔊</button>
      <div>
        <div class="dlg-py" style="margin-bottom:0;">${x.py}</div>
        <div class="hanzi" style="font-size:1.25rem;font-weight:700;color:var(--ink);">${x.hz}</div>
        <div style="color:var(--gray);font-size:.85rem;">${x.vi}</div>
      </div>
    </div>`).join('');
}
renderGM('gm-1', GM_EXAMPLES.gm1);
renderGM('gm-2', GM_EXAMPLES.gm2);
renderGM('gm-3', GM_EXAMPLES.gm3);
renderGM('gm-4', GM_EXAMPLES.gm4);

const GM_PRACTICE = [
  {q:"王一飞老师 ___ 二十个学生。", a:"有", vi:"Cô giáo Vương Nhất Phi có hai mươi học sinh."},
  {q:"杨同乐家 ___ 四口人。", a:"有", vi:"Nhà Dương Đồng Lạc có bốn người."},
  {q:"我有两个孩子，你 ___？", a:"呢", vi:"Tôi có hai đứa con, còn bạn thì sao?"},
  {q:"我 ___ 孩子。", a:"没", vi:"Tôi không có con."},
  {q:"您女儿今年多 ___？", a:"大", vi:"Con gái chị năm nay bao nhiêu tuổi?"}
];
function renderGmPractice(){
  document.getElementById('gm-practice').innerHTML = GM_PRACTICE.map((p,i)=>`
    <div class="fill-line hanzi">
      ${i+1}. ${p.q.replace('___', `<input type="text" id="gmp-${i}" style="width:56px;text-align:center;border:2px solid var(--red-light);border-radius:8px;padding:4px 6px;font-family:'Noto Sans SC';font-size:1.05rem;">`)}
      <button class="btn-mini yes" style="margin-left:8px;" onclick="checkGmp(${i})">Kiểm tra</button>
      <span id="gmp-result-${i}"></span>
      <div style="color:var(--gray);font-size:.8rem;font-family:'Be Vietnam Pro';">${p.vi}</div>
    </div>`).join('');
}
function checkGmp(i){
  const inp = document.getElementById('gmp-'+i);
  const res = document.getElementById('gmp-result-'+i);
  if(inp.value.trim()===GM_PRACTICE[i].a){ res.innerHTML=' <span class="result-ok">✔ Đúng!</span>'; celebrate(inp,1); }
  else { res.innerHTML=' <span class="result-bad">✘ Đáp án đúng: '+GM_PRACTICE[i].a+'</span>'; fail(inp); }
}
renderGmPractice();

/* ============ TAB FLASHCARD ============ */
let fcIndex = 0;
const fcKnownSet = new Set();
const fcCard = document.getElementById('flashcard');
function renderFC(){
  const v = VOCAB[fcIndex];
  document.getElementById('fc-hz').textContent = v.hz;
  document.getElementById('fc-pinyin').textContent = v.py;
  document.getElementById('fc-mean').textContent = v.mean;
  document.getElementById('fc-progress').textContent = (fcIndex+1)+' / '+VOCAB.length;
  fcCard.classList.remove('flipped');
}
function flipCard(){ fcCard.classList.toggle('flipped'); }
function fcNext(){ fcIndex = (fcIndex+1)%VOCAB.length; renderFC(); }
function fcPrev(){ fcIndex = (fcIndex-1+VOCAB.length)%VOCAB.length; renderFC(); }
function fcKnown(yes){
  if(yes && !fcKnownSet.has(fcIndex)){
    fcKnownSet.add(fcIndex);
    document.getElementById('fc-known-count').textContent = fcKnownSet.size;
    celebrate(fcCard, 2);
    if(fcKnownSet.size === VOCAB.length){ showToast('⭐ Thuộc hết từ vựng Bài 4!','gold'); fireConfetti(); }
  } else if(!yes){
    fcKnownSet.delete(fcIndex);
    document.getElementById('fc-known-count').textContent = fcKnownSet.size;
  }
  fcNext();
}
fcCard.addEventListener('click', flipCard);
renderFC();

/* ============ TAB LUYỆN VIẾT CÂU ============ */
let scoreTotal = 0, scoreMax = 0;
function addScore(n){ scoreTotal += n; document.getElementById('total-score').textContent = scoreTotal; }
function addMax(n){ scoreMax += n; document.getElementById('total-max').textContent = scoreMax; }

/* --- Dạng 3: điền từ (dropdown) --- */
const FILL_DATA = [
  {before:"王一飞老师有", blank:"二十", options:["二十","没","口"], after:"个学生。", vi:"(Cô giáo Vương Nhất Phi có hai mươi học sinh.)"},
  {before:"杨同乐家有四", blank:"口", options:["口","呢","大"], after:"人。", vi:"(Nhà Dương Đồng Lạc có bốn người.)"},
  {before:"王一雪：我有两个孩子，你", blank:"呢", options:["呢","的","是"], after:"？", vi:"(Tôi có hai đứa con, còn bạn thì sao?)"},
  {before:"杨同乐：我", blank:"没", options:["没","有","几"], after:"孩子。", vi:"(Tôi không có con.)"},
  {before:"杨同乐：您女儿今年多", blank:"大", options:["大","多少","几"], after:"？", vi:"(Con gái chị năm nay bao nhiêu tuổi?)"},
  {before:"你家有", blank:"几", options:["几","个","多"], after:"口人？", vi:"(Nhà bạn có mấy người?)"},
  {before:"我", blank:"有", options:["有","是","呢"], after:"两个哥哥。", vi:"(Tôi có hai anh trai.)"}
];
const fillContainer = document.getElementById('fill-container');
FILL_DATA.forEach((f,i)=>{
  const shuffled = [...f.options].sort(()=>Math.random()-0.5);
  const div = document.createElement('div');
  div.className = 'fill-line';
  div.innerHTML = `${i+1}. ${f.before}
    <select class="blank hanzi" data-answer="${f.blank}" data-idx="${i}">
      <option value="">--chọn--</option>
      ${shuffled.map(o=>`<option value="${o}">${o}</option>`).join('')}
    </select>
    ${f.after} <span style="color:var(--gray);font-size:.82rem;">${f.vi}</span>`;
  fillContainer.appendChild(div);
});
addMax(FILL_DATA.length);
let fillScored = false;
function checkFill(){
  let ok=0;
  document.querySelectorAll('#fill-container select').forEach(sel=>{
    sel.classList.remove('ok','bad');
    if(sel.value === sel.dataset.answer){ ok++; sel.classList.add('ok'); celebrate(sel,3); }
    else { sel.classList.add('bad'); fail(sel); }
  });
  document.getElementById('fill-result').innerHTML =
    ok===FILL_DATA.length ? `<span class="result-ok">Đúng ${ok}/${FILL_DATA.length} 🎉</span>`
                           : `<span class="result-bad">Đúng ${ok}/${FILL_DATA.length}</span>`;
  if(!fillScored){ addScore(ok); fillScored = true; }
  if(ok===FILL_DATA.length){ unlockBadge('fill'); fireConfetti(); showToast('🎯 Hoàn thành Dạng 3 xuất sắc!'); }
}

/* --- Dạng 4: sắp xếp từ thành câu --- */
const ORDER_DATA = [
  {words:["她","有","二十个","学生","。"], answer:"她有二十个学生。", vi:"Chị ấy có hai mươi học sinh."},
  {words:["我","家","有","四口人","。"], answer:"我家有四口人。", vi:"Nhà tôi có bốn người."},
  {words:["你","家","有","几口人","？"], answer:"你家有几口人？", vi:"Nhà bạn có mấy người?"},
  {words:["我","有","两个","孩子","。"], answer:"我有两个孩子。", vi:"Tôi có hai đứa con."}
];
const orderContainer = document.getElementById('order-container');
ORDER_DATA.forEach((o,idx)=>{
  const wrap = document.createElement('div');
  wrap.style.marginBottom = '18px';
  const shuffledWords = [...o.words].sort(()=>Math.random()-0.5);
  wrap.innerHTML = `
    <div style="font-size:.85rem;color:var(--gray);margin-bottom:4px;">Câu ${idx+1} · ${o.vi}</div>
    <div class="order-zone hanzi" id="zone-${idx}"></div>
    <div class="order-bank hanzi" id="bank-${idx}"></div>
    <button class="btn secondary" onclick="resetOrder(${idx})">↺ Làm lại</button>
    <button class="btn btn-check" onclick="checkOrder(${idx})">Kiểm tra</button>
    <span id="order-result-${idx}"></span>`;
  orderContainer.appendChild(wrap);
  window['orderWords_'+idx] = shuffledWords;
  window['orderAns_'+idx] = o.answer;
  renderOrder(idx);
});
addMax(ORDER_DATA.length);
function renderOrder(idx){
  const bank = document.getElementById('bank-'+idx);
  const zone = document.getElementById('zone-'+idx);
  bank.innerHTML=''; zone.innerHTML='';
  window['orderWords_'+idx].forEach(w=>{
    const chip = document.createElement('span');
    chip.className='order-item';
    chip.textContent=w;
    chip.onclick=()=>{ zone.appendChild(chip); chip.classList.add('chosen'); chip.onclick=()=>{bank.appendChild(chip); chip.classList.remove('chosen');chip.onclick=chip.onclick;}; moveToBank(chip,bank,zone);};
    bank.appendChild(chip);
  });
}
function moveToBank(chip,bank,zone){
  chip.onclick = ()=>{ bank.appendChild(chip); chip.classList.remove('chosen'); chip.onclick=()=>{ zone.appendChild(chip); chip.classList.add('chosen'); moveToBank(chip,bank,zone); }; };
}
function resetOrder(idx){ renderOrder(idx); document.getElementById('order-result-'+idx).innerHTML=''; document.getElementById('zone-'+idx).classList.remove('ok','bad'); }
let orderCompleted = new Set();
function checkOrder(idx){
  const zone = document.getElementById('zone-'+idx);
  const built = Array.from(zone.children).map(c=>c.textContent).join('');
  const res = document.getElementById('order-result-'+idx);
  zone.classList.remove('ok','bad');
  if(built === window['orderAns_'+idx]){
    res.innerHTML = `<span class="result-ok">✔ Chính xác! ${built}</span>`;
    zone.classList.add('ok');
    if(!orderCompleted.has(idx)){ orderCompleted.add(idx); celebrate(zone,4); }
    if(orderCompleted.size===ORDER_DATA.length){ unlockBadge('order'); showToast('🧩 Sắp câu hoàn hảo!'); }
  } else {
    res.innerHTML = `<span class="result-bad">✘ Chưa đúng. Đáp án: ${window['orderAns_'+idx]}</span>`;
    zone.classList.add('bad'); fail(zone);
  }
}

/* --- tiện ích: xáo trộn mảng --- */
function shuffleArr(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}

/* --- Dạng 1: nghe chọn từ vựng nghe được --- */
const LISTEN_VOCAB_DATA = [
  VOCAB.find(v=>v.hz==="有"),
  VOCAB.find(v=>v.hz==="哥哥"),
  VOCAB.find(v=>v.hz==="家"),
  VOCAB.find(v=>v.hz==="爸爸"),
  VOCAB.find(v=>v.hz==="女儿"),
  VOCAB.find(v=>v.hz==="岁")
];
const listenVocabContainer = document.getElementById('listen-vocab-container');
let listenVocabScored = 0;
LISTEN_VOCAB_DATA.forEach((item,idx)=>{
  const distractors = shuffleArr(VOCAB.filter(v=>v.hz!==item.hz)).slice(0,3);
  const options = shuffleArr([item, ...distractors]);
  const div = document.createElement('div');
  div.className = 'listen-item';
  div.innerHTML = `
    <div class="listen-head">
      <span class="listen-num">Câu ${idx+1}.</span>
      <button class="btn-listen" onclick="speak('${item.hz}')">🔊</button>
    </div>
    <div class="mc-options" id="lv-opts-${idx}">
      ${options.map(o=>`<button class="mc-opt hanzi" onclick="checkListenVocab(this,${idx},'${o.hz}')">${o.hz}</button>`).join('')}
    </div>`;
  listenVocabContainer.appendChild(div);
});
addMax(LISTEN_VOCAB_DATA.length);
function checkListenVocab(btn, idx, chosen){
  const correct = LISTEN_VOCAB_DATA[idx].hz;
  const opts = document.querySelectorAll('#lv-opts-'+idx+' .mc-opt');
  opts.forEach(o=>{ o.disabled = true; if(o.textContent===correct) o.classList.add('ok'); else o.classList.add('dim'); });
  if(chosen===correct){
    btn.classList.remove('dim'); addScore(1); celebrate(btn,1);
  } else {
    btn.classList.remove('dim'); btn.classList.add('bad'); fail(btn);
  }
  listenVocabScored++;
  if(listenVocabScored===LISTEN_VOCAB_DATA.length){ checkListenDone(); }
}

/* --- Dạng 2: nghe chọn câu nghe được --- */
const ALL_SENTENCES = [].concat(DIALOGUES.d1, DIALOGUES.d2, DIALOGUES.d3);
const LISTEN_SENTENCE_DATA = [
  ALL_SENTENCES.find(s=>s.hz==="她有二十个学生。"),
  ALL_SENTENCES.find(s=>s.hz==="我有两个哥哥，你呢？"),
  ALL_SENTENCES.find(s=>s.hz==="你家有几口人？"),
  ALL_SENTENCES.find(s=>s.hz==="您儿子几岁？"),
  ALL_SENTENCES.find(s=>s.hz==="他今年五岁。")
];
const listenSentenceContainer = document.getElementById('listen-sentence-container');
let listenSentenceScored = 0;
LISTEN_SENTENCE_DATA.forEach((item,idx)=>{
  const distractors = shuffleArr(ALL_SENTENCES.filter(s=>s.hz!==item.hz)).slice(0,3);
  const options = shuffleArr([item, ...distractors]);
  const div = document.createElement('div');
  div.className = 'listen-item';
  div.innerHTML = `
    <div class="listen-head">
      <span class="listen-num">Câu ${idx+1}.</span>
      <button class="btn-listen" onclick="speak('${item.hz}')">🔊</button>
    </div>
    <div class="mc-options" id="ls-opts-${idx}">
      ${options.map(o=>`<button class="mc-opt hanzi" style="font-size:1.05rem;" onclick="checkListenSentence(this,${idx},'${o.hz}')">${o.hz}</button>`).join('')}
    </div>`;
  listenSentenceContainer.appendChild(div);
});
addMax(LISTEN_SENTENCE_DATA.length);
function checkListenSentence(btn, idx, chosen){
  const correct = LISTEN_SENTENCE_DATA[idx].hz;
  const opts = document.querySelectorAll('#ls-opts-'+idx+' .mc-opt');
  opts.forEach(o=>{ o.disabled = true; if(o.textContent===correct) o.classList.add('ok'); else o.classList.add('dim'); });
  if(chosen===correct){
    btn.classList.remove('dim'); addScore(1); celebrate(btn,1);
  } else {
    btn.classList.remove('dim'); btn.classList.add('bad'); fail(btn);
  }
  listenSentenceScored++;
  if(listenSentenceScored===LISTEN_SENTENCE_DATA.length){ checkListenDone(); }
}

function checkListenDone(){
  if(listenVocabScored===LISTEN_VOCAB_DATA.length && listenSentenceScored===LISTEN_SENTENCE_DATA.length){
    unlockBadge('listen'); showToast('🎧 Hoàn thành bài nghe!');
  }
}

/* ============ TAB CHỮ HÁN (Hanzi Writer) ============ */
let hanziWriterInstance = null;
let currentHanziIdx = 0;

const hzPicker = document.getElementById('hz-picker');
HANZI_LIST.forEach((h,idx)=>{
  const chip = document.createElement('div');
  chip.className = 'hz-chip hanzi' + (idx===0?' active':'');
  chip.textContent = h.char;
  chip.onclick = ()=>selectHanzi(idx);
  hzPicker.appendChild(chip);
});

function loadHanziWriterScript(cb){
  if(window.HanziWriter){ cb(); return; }
  const sources = [
    'https://cdn.jsdelivr.net/npm/hanzi-writer@3/dist/hanzi-writer.min.js',
    'https://unpkg.com/hanzi-writer@3/dist/hanzi-writer.min.js'
  ];
  let i=0;
  function tryLoad(){
    if(i>=sources.length){ document.getElementById('hanzi-target').innerHTML = '<div class="locked-msg">Không tải được thư viện Hanzi Writer (kiểm tra kết nối mạng).</div>'; return; }
    const s = document.createElement('script');
    s.src = sources[i];
    s.onload = cb;
    s.onerror = ()=>{ i++; tryLoad(); };
    document.head.appendChild(s);
  }
  tryLoad();
}

function selectHanzi(idx){
  currentHanziIdx = idx;
  document.querySelectorAll('.hz-chip').forEach((c,i)=>c.classList.toggle('active', i===idx));
  const h = HANZI_LIST[idx];
  document.getElementById('hz-pinyin').textContent = h.py;
  document.getElementById('hz-radical').textContent = h.radical;
  document.getElementById('hz-strokes').textContent = h.strokes;
  document.getElementById('hz-mean').textContent = h.mean;
  document.getElementById('hz-tip').textContent = h.tip;
  drawHanzi(h.char);
}

function drawHanzi(char){
  const target = document.getElementById('hanzi-target');
  target.innerHTML = '';
  loadHanziWriterScript(()=>{
    try{
      hanziWriterInstance = HanziWriter.create('hanzi-target', char, {
        width: 260, height: 260,
        padding: 12,
        strokeColor: '#B35D52',
        radicalColor: '#D98A80',
        showOutline: true,
        strokeAnimationSpeed: 1,
        delayBetweenStrokes: 200
      });
    }catch(e){
      target.innerHTML = '<div class="locked-msg">Không tải được nét chữ "'+char+'".</div>';
    }
  });
}
function hzAnimate(){ if(hanziWriterInstance) hanziWriterInstance.animateCharacter(); }
function hzQuiz(){
  if(!hanziWriterInstance) return;
  hanziWriterInstance.quiz({
    onComplete: (summary)=>{
      const target = document.getElementById('hanzi-target');
      celebrate(target, 5);
      unlockBadge('hanzi');
      showToast('字 Viết đúng chữ '+HANZI_LIST[currentHanziIdx].char+'!','gold');
    }
  });
}
function hzOutline(){
  if(!hanziWriterInstance) return;
  hanziWriterInstance.hideCharacter();
  hanziWriterInstance.showOutline();
}
// khởi tạo chữ đầu tiên
selectHanzi(0);
</script>


</body></html>
