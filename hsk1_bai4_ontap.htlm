<script>
/* ============ DỮ LIỆU BÀI 4 ============ */
const VOCAB = [
  {hz:"有", py:"yǒu", pos:"đgt.", mean:"có"},
  {hz:"多少", py:"duōshao", pos:"đt.", mean:"bao nhiêu"},
