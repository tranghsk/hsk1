    {who:"Vương Nhất Tuyết (王一雪)", hz:"她很忙。", py:"Tā hěn máng.", vi:"Chị ấy rất bận."},
    {who:"刘明", hz:"她有多少个学生？", py:"Tā yǒu duōshao gè xuésheng?", vi:"Chị ấy có bao nhiêu học sinh?"},
    {who:"王一雪", hz:"她有二十个学生。", py:"Tā yǒu èrshí gè xuésheng.", vi:"Chị ấy có hai mươi học sinh."}
  ],
  d2:[
    {who:"Vương Nhất Tuyết (王一雪)", hz:"我有两个哥哥，你呢？", py:"Wǒ yǒu liǎng gè gēge, nǐ ne?", vi:"Tôi có hai anh trai, còn bạn thì sao?"},
    {who:"Dương Đồng Lạc (杨同乐)", hz:"我没有哥哥。", py:"Wǒ méiyǒu gēge.", vi:"Tôi không có anh trai."},
    {who:"王一雪", hz:"你家有几口人？", py:"Nǐ jiā yǒu jǐ kǒu rén?", vi:"Nhà bạn có mấy người?"},
    {who:"杨同乐", hz:"我家有四口人，爸爸、妈妈、妹妹和我。", py:"Wǒ jiā yǒu sì kǒu rén, bàba, māma, mèimei hé wǒ.", vi:"Nhà tôi có bốn người: bố, mẹ, em gái và tôi."}
  ],
  d3:[
    {who:"Dương Đồng Lạc (杨同乐)", hz:"这是您儿子吗？", py:"Zhè shì nín érzi ma?", vi:"Đây là con trai của chị à?"},
    {who:"Vương Nhất Tuyết (王一雪)", hz:"是的。我有两个孩子，一个儿子，一个女儿。", py:"Shì de. Wǒ yǒu liǎng gè háizi, yí gè érzi, yí gè nǚ'ér.", vi:"Đúng vậy. Tôi có hai đứa con, một trai một gái."},
    {who:"杨同乐", hz:"您儿子几岁？", py:"Nín érzi jǐ suì?", vi:"Con trai chị mấy tuổi?"},
